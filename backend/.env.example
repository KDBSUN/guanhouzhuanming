# 复制本文件为 .env 并填入真实值。任何密钥都不要提交进 git（.gitignore 已排除 .env）。
# 各键用途见下；留空的键表示"该功能未配置"，后端会如实回报，不报错冒充可用。

# --- 大模型（解卦 / 行动建议）---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# --- 反馈邮件（SMTP，授权码只存在 .env；绝不进前端/代码库）---
# QQ 邮箱：smtp.qq.com，SSL 465；SMTP_PASS 填"授权码"而非登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO=

# --- 站长端点令牌（校准提案的生成/批准、留言收件箱）---
# 请求时带 X-Admin-Token 头；未配置时这些端点自动关闭（503）——配置缺失表现为"用不了"，而非"谁都能用"
ADMIN_TOKEN=

# --- 语音转文字（服务端 ASR）---
# ASR_BASE_URL 填任何 OpenAI 兼容的语音转写服务地址（填到 /v1 这一层，不要自带 /audio/transcriptions）
# 默认给阿里云百炼（DashScope 兼容模式）
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_PROVIDER=dashscope
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_TIMEOUT=30

# --- 上线前必看 ---
# CORS：把自己的域名写进来（逗号分隔）。留空 = 只放行本机开发端口(3000/5173)。
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
# 反向代理：跑在 Nginx/Caddy 之后才设 1（并让代理覆写 XFF）；直连公网必须留空。
# TRUST_PROXY=1
